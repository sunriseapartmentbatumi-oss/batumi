# Skopiuj do .env.local i uzupełnij lokalnie. NIGDY nie commituj wartości (D034, D057).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Tylko serwer – nigdy z prefiksem NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
RESEND_API_KEY=
BOOKING_NOTIFY_EMAIL=
BOOKING_FROM_EMAIL=
# Maile do gości: wyłączone domyślnie; włącz (true) dopiero z BOOKING_FROM_EMAIL z własnej zweryfikowanej domeny
GUEST_EMAIL_ENABLED=
